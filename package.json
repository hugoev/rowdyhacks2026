{
  "name": "tripwire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "predev": "node scripts/check-runtime.mjs",
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/check-runtime.mjs",
    "build": "next build --webpack",
    "prestart": "node scripts/check-runtime.mjs",
    "start": "node --import tsx scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "eval:gemini": "node --import tsx scripts/eval-gemini.ts"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.26.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.18.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3"
  }
}
