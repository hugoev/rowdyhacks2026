HOST=127.0.0.1
PORT=3000
# Exact origin every page uses (phones need HTTPS for the mic).
PUBLIC_BASE_URL=http://localhost:3000
# Optional: require this key for /operator actions on a hosted demo.
OPERATOR_KEY=

# Gemini 3.8 Live: the safety teller. The key stays on the server; browsers get
# single-use ephemeral tokens with the prompt and tools locked in.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Optional prebuilt voice name for the teller (leave empty for the default).
GEMINI_VOICE=

# ElevenLabs: the two phone agents (npm run setup:agents prints the ids).
ELEVENLABS_API_KEY=
# Consented instant voice clone of our teammate (written consent: docs/CONSENT.md). Demo only.
ELEVENLABS_SCAMMER_VOICE_ID=
# Tripwire's calm stock voice for the verifier.
ELEVENLABS_VERIFIER_VOICE_ID=EXAVITQu4vr4xnSDxMaL
EL_AGENT_SCAMMER_ID=
EL_AGENT_VERIFIER_ID=

# Tiger Data (Postgres + TimescaleDB): Rosa's history and case files. npm run seed.
# Without it, the same synthetic history is used locally (labeled "local").
TIGER_DATABASE_URL=
TIGER_CA_CERT=
