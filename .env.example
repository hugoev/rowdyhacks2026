HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
# Optional Tiger Data risk analytics. Keep the real URL in .env only.
DATABASE_URL=
# Optional PEM CA certificate if your database uses a private certificate chain.
TIGER_CA_CERT=
# Solana is always devnet. Leave program/guardian empty for explicit Web2 fallback.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
SOLANA_GUARDIAN_PUBLIC_KEY=
SOLANA_RECIPIENT_PUBLIC_KEY=
# Optional private keypair file. Otherwise a devnet-only payer persists in SQLite.
SOLANA_KEYPAIR_PATH=
# Local demo: role switching is public. Never use real personal information.
DEMO_MODE=true
# Required for each role when DEMO_MODE=false. Choose separate long random codes.
PROTECTED_ACCESS_CODE=
GUARDIAN_ACCESS_CODE=
RELATIVE_ACCESS_CODE=
# Set true behind an HTTPS reverse proxy.
COOKIE_SECURE=false
# Gemini Live is the call brain. The key stays on the server; browsers get
# short-lived ephemeral tokens. Without a key, the rule spotter runs alone (labeled).
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# ElevenLabs: Tripwire's voice (streaming TTS), the consented scammer agent, and evals.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_ID_ES=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Consented voice clone of our teammate (written consent on file). Demo and red-team only.
ELEVENLABS_SCAMMER_VOICE_ID=
# Printed by npm run setup:agent.
ELEVENLABS_AGENT_ID=
# Optional comma-separated voice IDs for npm run eval:live.
ELEVENLABS_EVAL_VOICES=

# PRD v3 keys (legacy names above remain supported during migration).
EL_AGENT_SCAMMER_ID=
EL_AGENT_VERIFIER_ID=
TIGER_DATABASE_URL=
PUBLIC_BASE_URL=

# Setup only: path to the voice owner confirmed consent note.
ELEVENLABS_SCAMMER_CONSENT_PATH=
