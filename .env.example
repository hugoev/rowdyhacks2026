HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
# Optional Tiger Data risk analytics. Keep the real URL in .env only.
DATABASE_URL=
# Optional PEM CA certificate if your database uses a private certificate chain.
TIGER_CA_CERT=
# Local demo: role switching is public. Never use real personal information.
DEMO_MODE=true
# Required for each role when DEMO_MODE=false. Choose separate long random codes.
PROTECTED_ACCESS_CODE=
GUARDIAN_ACCESS_CODE=
RELATIVE_ACCESS_CODE=
# Set true behind an HTTPS reverse proxy.
COOKIE_SECURE=false
# Optional providers. Rules, scripted calls, and browser voice work without keys.
GEMINI_API_KEY=
# Optional legacy override for all tasks. Task-specific settings take precedence.
GEMINI_MODEL=
GEMINI_CALL_MODEL=gemini-3.5-flash-lite
GEMINI_SCAN_MODEL=gemini-3.8-flash
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
# Lower this to match your AI Studio project quota. No billing is enabled by Tripwire.
GEMINI_MAX_REQUESTS_PER_MINUTE=10
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
